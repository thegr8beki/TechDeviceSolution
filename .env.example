# ========== NEXTAUTH ==========
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"

# ========== GOOGLE OAUTH ==========
# How to obtain:
#  1. Go to https://console.cloud.google.com/  →  APIs & Services  →  Credentials
#  2. Create an OAuth 2.0 Client ID of type "Web application"
#  3. Add these Authorized redirect URIs:
#       http://localhost:3000/api/auth/callback/google
#       https://YOUR-PRODUCTION-DOMAIN/api/auth/callback/google
#  4. Copy Client ID and Client Secret below.
# While these are blank, the "Continue with Google" button stays in a friendly
# "not configured" state instead of failing silently.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" once both values above are real. The client uses this to
# render the button in enabled vs setup-mode state.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ========== JWT ==========
JWT_SECRET="another-secure-random-string"
JWT_EXPIRES_IN="7d"

