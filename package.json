{
  "name": "techdevicesolution",
  "version": "1.0.0",
  "private": true,
  "description": "TechDeviceSolution — Premium Technology Service Platform",
  "author": "Bereket Mihretu",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate || echo \"prisma generate skipped\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",

    "mobile:export": "next build && next export -o mobile-app",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-accordion": "^1.2.0",
